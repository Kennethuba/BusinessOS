<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same rules for the Google account backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="business_os.db" />
        <include domain="database" path="business_os.db-wal" />
        <include domain="database" path="business_os.db-shm" />
        <include domain="file" path="logos/" />
        <include domain="file" path="stock_images/" />
        <include domain="sharedpref" path="app_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="business_os.db" />
        <include domain="database" path="business_os.db-wal" />
        <include domain="database" path="business_os.db-shm" />
        <include domain="file" path="logos/" />
        <include domain="file" path="stock_images/" />
        <include domain="sharedpref" path="app_settings.xml" />
    </device-transfer>
</data-extraction-rules>
