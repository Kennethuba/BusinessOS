<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic backup to the owner's Google account (Google Drive).
     The database, logos and photos are kept. Who is signed in is not: after a restore
     everyone must enter their PIN again. -->
<full-backup-content>
    <include domain="database" path="business_os.db" />
    <include domain="database" path="business_os.db-wal" />
    <include domain="database" path="business_os.db-shm" />
    <include domain="file" path="logos/" />
    <include domain="file" path="stock_images/" />
    <include domain="sharedpref" path="app_settings.xml" />
    <exclude domain="sharedpref" path="session.xml" />
    <exclude domain="sharedpref" path="app_lock.xml" />
    <exclude domain="file" path="last_crash.txt" />
</full-backup-content>
